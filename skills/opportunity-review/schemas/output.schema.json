{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-town.example/skills/opportunity-review/output.schema.json",
  "title": "Opportunity Review Record Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "organization", "bucket", "deadline", "summary", "directions", "source_url", "confirmation_status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "organization": { "type": "string", "minLength": 1 },
    "bucket": { "enum": ["focus", "explore", "watch", "exclude"] },
    "deadline": { "anyOf": [{"type": "null"}, {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}] },
    "summary": { "type": "string", "minLength": 40 },
    "directions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "source_url": { "type": ["string", "null"], "format": "uri" },
    "confirmation_status": { "const": "pending" }
  }
}
