{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-town.example/skills/skill-gap/output.schema.json",
  "title": "Skill Gap Record Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "level", "learning_feeling", "related_directions", "next_practice", "updated_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "level": { "type": "integer", "minimum": 1, "maximum": 4 },
    "learning_feeling": { "type": "string", "minLength": 1 },
    "related_directions": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "assessment_note": { "type": "string", "minLength": 1 },
    "next_practice": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
