{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "skill", "generated_at", "records", "unknowns"],
  "properties": {
    "schema_version": {"const": 1}, "skill": {"const": "resume-composer"},
    "generated_at": {"type": "string", "format": "date-time"},
    "records": {"type": "array", "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "status", "data"], "properties": {"type": {"const": "resume_draft"}, "status": {"const": "pending"}, "data": {"$ref": "output.schema.json"}}}},
    "unknowns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
